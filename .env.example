# ====== RFO environment (generated by bootstrap.ps1 - NEVER commit .env) ======
# -Force rotates ALL secrets; recreate data volumes afterwards (docker compose down -v).
COMPOSE_PROJECT_NAME=rfo
APP_ENV=development
LOG_LEVEL=INFO
TZ=UTC

# ---- Hostnames (*.localhost resolves to 127.0.0.1 in modern browsers) ----
DOMAIN_STORE=shop.rfo.localhost
DOMAIN_ADMIN=admin.rfo.localhost
DOMAIN_API=api.rfo.localhost

# ---- CORS allowlists (exact origins, one per trust zone) ----
CORS_ORIGINS_STORE=https://shop.rfo.localhost
CORS_ORIGINS_STAFF=https://admin.rfo.localhost

# ---- PostgreSQL 16 ----
# pgcrypto = PII column encryption only. Passwords are hashed in the app (Argon2id).
POSTGRES_SUPERUSER=rfo_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
POSTGRES_DB=rfo
DB_MIGRATOR_USER=rfo_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME
DB_APP_USER=rfo_app
DB_APP_PASSWORD=CHANGE_ME
DB_READONLY_USER=rfo_ro
DB_READONLY_PASSWORD=CHANGE_ME

# ---- PgBouncer (transaction mode; app must disable statement caching) ----
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_DEFAULT_POOL_SIZE=25
PGBOUNCER_MAX_CLIENT_CONN=1000

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME

# ---- MinIO (S3-compatible object storage for media) ----
MINIO_ROOT_USER=rfo_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_MEDIA=rfo-media

# ---- Auth ----
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
PII_ENCRYPTION_KEY=CHANGE_ME
CSRF_SECRET=CHANGE_ME

# ---- Rate limits (Nginx zones; app-level limits added in Phase 3) ----
RATE_LIMIT_STORE_RPS=20
RATE_LIMIT_STAFF_RPS=10
RATE_LIMIT_LOGIN_RPM=10

# ---- Autonomy (ADR 0008 decision 6 - the OUTER of the two kill switches) ----
# AI_AUTONOMY=false is the default and the shipped value: while it is false, an agent execute turn
# is answered as a PROPOSAL (a human still Confirms) and no agent write can land, whatever the
# grant ledger says. Setting it true is necessary but NOT sufficient - a per-grant `enabled` row
# (backoffice -> Agents -> grants) must exist for that identity and action as well. Both, or the
# rail is propose-only. Changing this value needs an api restart: `docker compose up -d api`.
# It gates the agent execute path only; the staff human-Confirm path never reads it.
AI_AUTONOMY=false

# AGENT_DAILY_CAP is the per-IDENTITY day budget (ADR 0007 decision 5), and it is CUMULATIVE with
# each grant's own daily_cap: both must be satisfied, so this is the ceiling on EVERYTHING one agent
# identity may execute in a day whatever its per-action caps say. Absent or empty = no identity cap
# (the shipped default - a budget nobody set is a number nobody chose). Anything else that is not a
# whole number reads as 0, not as "no cap": a typo must not silently remove a control, so the rail
# degrades to propose-only until it is fixed. Needs the same api restart as AI_AUTONOMY.
AGENT_DAILY_CAP=

# ---- Frontends ----
NEXT_PUBLIC_API_URL=https://api.rfo.localhost
NEXT_PUBLIC_SITE_URL=https://shop.rfo.localhost