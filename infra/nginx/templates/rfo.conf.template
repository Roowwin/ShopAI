map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}

gzip on;
gzip_comp_level 5;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;
gzip_min_length 1024;

limit_req_zone  $binary_remote_addr zone=store:10m        rate=${RATE_LIMIT_STORE_RPS}r/s;
limit_req_zone  $binary_remote_addr zone=staff:10m        rate=${RATE_LIMIT_STAFF_RPS}r/s;
limit_req_zone  $binary_remote_addr zone=login:10m        rate=${RATE_LIMIT_LOGIN_RPM}r/m;
limit_req_zone  $binary_remote_addr zone=assistant:10m    rate=10r/m;
limit_conn_zone $binary_remote_addr zone=perip:10m;
resolver 127.0.0.11 valid=10s ipv6=off;

log_format json_main escape=json '{"ts":"$time_iso8601","req_id":"$request_id","remote":"$remote_addr","method":"$request_method","uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,"rt":$request_time,"u_rt":"$upstream_response_time"}';
access_log /var/log/nginx/access.log json_main;
error_log  /var/log/nginx/error.log warn;

# upstreams resolve per-request via Docker DNS (resolver below); no startup dependency

server {
  listen 80 default_server;
  server_name _;
  location = /healthz { access_log off; return 200 "ok\n"; }
  location / { return 503 "RFO edge up - route not wired\n"; }
}

server {
  listen 80;
  server_name ${DOMAIN_STORE} ${DOMAIN_ADMIN} ${DOMAIN_API};
  location = /healthz { access_log off; return 200 "ok\n"; }
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN_API};
  set $up_api api:8000;
  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/headers.conf;
  client_max_body_size 25m;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Request-ID $request_id;
  proxy_set_header Connection "";

  location ~ ^/staff/auth/login$ { limit_req zone=login burst=5 nodelay; proxy_pass http://$up_api; }
  location ~ ^/store/assistant/chat$ { limit_req zone=assistant burst=2 nodelay; client_max_body_size 2k; proxy_read_timeout 190s; proxy_send_timeout 190s; proxy_pass http://$up_api; }
  location ~ ^/store/auth/login$ { limit_req zone=login burst=5 nodelay; proxy_pass http://$up_api; }
  # The staff chat door: rate-limited like the public assistant precedent above (zone=staff, the
  # same zone the generic ^/staff/ block uses). Must stay ahead of ^/staff/ai/ - regex locations
  # match in order, first wins - or the long-timeout block below swallows it.
  # 16k, NOT the storefront's 2k: ChatIn.message allows 2000 CHARACTERS and nginx counts BYTES, so
  # a Confirm turn re-sending the same long message (or any non-ASCII text) must still fit. The cap
  # is on the chat route ONLY - ^/staff/ai/ also serves the multipart intake-draft upload.
  location ~ ^/staff/ai/chat$ { limit_req zone=staff burst=20 nodelay; client_max_body_size 16k; proxy_read_timeout 190s; proxy_send_timeout 190s; proxy_pass http://$up_api; }
  # The agent chat mirror (POST /staff/agents/chat): the same chat door, reached with an agent
  # token. It must carry the SAME edge limits as ^/staff/ai/chat$ above, and for a sharper reason:
  # without its own block it inherits this server's 25m body cap and 60s proxy timeout, and since
  # Starlette reads and JSON-parses the body before any dependency runs, that is an unauthenticated
  # body-read surface ~1600x larger than the door's. Order matters the same way - it has to sit
  # ahead of ^/staff/ - and the 16k cap is the same 16k: it is the SAME ChatIn payload shape.
  location ~ ^/staff/agents/chat$ { limit_req zone=staff burst=20 nodelay; client_max_body_size 16k; proxy_read_timeout 190s; proxy_send_timeout 190s; proxy_pass http://$up_api; }
  location ~ ^/staff/ai/ { limit_req zone=staff burst=20 nodelay; proxy_read_timeout 190s; proxy_send_timeout 190s; proxy_pass http://$up_api; }
  location ~ ^/staff/ { limit_req zone=staff burst=20 nodelay; proxy_pass http://$up_api; }
  location ~ ^/store/ { limit_req zone=store burst=40 nodelay; proxy_pass http://$up_api; }
  location / { proxy_pass http://$up_api; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN_STORE};
  set $up_store storefront:3001;
  set $up_storage storage:5000;
  set $up_store_api api:8000;
  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/headers.conf;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://${DOMAIN_API} ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
  client_max_body_size 25m;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  # PRODUCT PHOTOGRAPHY, SERVED FROM THE PAGE'S OWN ORIGIN. A catalogue tile renders
  # `products.image_url` in a plain <img> with no credential, and the shop's CSP is
  # `img-src 'self'`, so the address has to be on THIS host or the browser refuses it.
  #
  # It used to point at the object store ($up_storage) - the moto bucket from ADR 0005, which
  # nothing in apps/backend ever wrote to, because uploaded bytes go to `media_objects` in
  # Postgres (0013). So this prefix answered 404 for every product photo the shop has ever had.
  # It now fronts the one route that actually holds them: /store/media/<public_id>, public and
  # immutable, and limited to images a product_group points at.
  #
  # When media moves to MinIO/S3 as ADR 0001 intends, this block points back at $up_storage and
  # nothing else in the stack changes - `services/media.py:public_address` is what mints the path.
  # THE REWRITE IS NOT OPTIONAL, AND IT IS NOT DECORATION. `proxy_pass` with a URI part
  # (`.../store/media/`) replaces the matched location prefix - but ONLY when the target is a
  # literal. The moment the host is a VARIABLE (as it must be here, to name the compose service and
  # let nginx resolve it at request time), nginx cannot work out the replacement at config time and
  # passes the request URI through UNCHANGED. The first cut of this block did exactly that and every
  # photo asked the API for `/media/<uuid>`, which is not a route: FastAPI answered its own generic
  # `{"detail":"Not Found"}`, so the shop showed broken tiles on every product with a photograph -
  # while `https://api.<domain>/store/media/<uuid>` returned the image perfectly, which is what made
  # it look like a frontend bug. `rewrite ... break` does the substitution explicitly.
  location /media/ {
    rewrite ^/media/(.*)$ /store/media/$1 break;
    proxy_pass http://$up_store_api;
    proxy_set_header Connection "";
    expires 365d;
    add_header Cache-Control "public, immutable" always;
  }
  location / { proxy_pass http://$up_store; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN_ADMIN};
  set $up_admin backoffice:3000;
  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/headers.conf;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://${DOMAIN_API} ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  location / { proxy_pass http://$up_admin; }
}